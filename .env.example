# API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://lenjoy_bbs:change-me@localhost:5432/lenjoy_bbs
REDIS_URL=redis://lenjoy_bbs:change-me@localhost:6379
REDIS_KEY_PREFIX=lenjoy_bbs
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars

# Legacy JDBC-style database settings remain supported for compatibility.
# Prefer DATABASE_URL for local development.
# DB_URL=jdbc:postgresql://localhost:5432/lenjoy_bbs
# DB_USER=lenjoy
# DB_PASSWORD=change-me
DB_NAME=lenjoy_bbs
DB_PORT=5432
# Local API process port when running outside the full Docker stack.
SERVER_PORT=8080
# Host port published by infra/docker/docker-compose.yml for the API container.
API_PORT=18080
LOG_PATH=./logs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Docker local dependencies (infra/docker/docker-compose.dev.yml)
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=lenjoy-bbs

# API MinIO integration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_PUBLIC_BASE_URL=/lenjoy-bbs

# Upload limits
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=5MB
MINIO_MAX_FILE_SIZE_BYTES=5242880

# App
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
# Server-side web requests outside Docker should call the published API port.
API_SERVER_BASE_URL=http://localhost:18080
# Local Next dev proxy target for MINIO_PUBLIC_BASE_URL=/lenjoy-bbs.
MINIO_PUBLIC_PROXY_TARGET=http://localhost:9000/lenjoy-bbs

# Internal automation services
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-token
TRANSFER_CALLBACK_TOKEN=change-me-to-a-long-random-token
FORUM_API_KEY=replace-with-an-active-open-api-client-key
DEFAULT_TRANSFER_TARGET_PATH=resource-transfer
TRANSFER_WORKER_COUNT=1
TRANSFER_TASK_LEASE_SECONDS=300
TRANSFER_WORKER_POLL_INTERVAL_SECONDS=1
TRANSFER_WEBHOOK_MAX_ATTEMPTS=8
TRANSFER_WEBHOOK_RETRY_BASE_SECONDS=5

# Platform E2E acceptance
E2E_RESOURCE_URL=https://pan.quark.cn/s/replace-with-stable-test-resource
E2E_FORUM_AUTHOR_BINDING_CODE=replace-with-open-api-binding-code
E2E_FORUM_CATEGORY_ID=1
E2E_FORUM_TAG_IDS=
E2E_FORUM_HIDDEN_CONTENT=E2E acceptance hidden content
E2E_FORUM_PRICE=1
E2E_TIMEOUT_SECONDS=900
E2E_POLL_INTERVAL_SECONDS=3
